<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:background="@color/background_beige">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableLayout
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="16dp"
            android:background="@android:color/transparent">

            <!-- Example Row -->
            <TableRow>
                <TextView
                    android:id="@+id/healthDetails"
                    android:fontFamily="@font/inria_serif_bold"
                    android:text="Health details"
                    android:gravity="start"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/ageAfter"
                    android:text=">"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:id="@+id/vision"
                    android:fontFamily="@font/inria_serif_bold"
                    android:text="Vision"
                    android:gravity="start"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/heightAfter"
                    android:text=">"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
            </TableRow>

        </TableLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/goProposal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        android:clickable="true"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settings">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="30dp"
            android:gravity="center">
            <TextView
                android:id="@+id/goPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inria_serif_bold"
                android:textStyle="bold"
                android:textSize="30sp"
                android:textColor="@color/dark_green"
                android:text="Go Premium"
                android:layout_marginVertical="20dp"
                app:layout_constraintHorizontal_bias="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/myCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        android:clickable="true"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/goProposal">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="30dp"
            android:gravity="center">
            <TextView
                android:id="@+id/logoutText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inria_serif_bold"
                android:textStyle="bold"
                android:textSize="30sp"
                android:textColor="#CC0000"
                android:text="Log Out"
                android:layout_marginVertical="20dp"
                app:layout_constraintHorizontal_bias="0.1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/ic_log_out"
                android:background="@android:color/transparent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>