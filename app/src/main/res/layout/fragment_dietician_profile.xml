<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerInfo"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Background Image FIRST to be behind -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePictureBackground"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/pfp_background"
            android:scaleType="centerCrop"
            android:layout_marginTop="130dp"
            android:layout_marginHorizontal="20dp"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/black_gradient_overlay"
            app:layout_constraintBottom_toBottomOf="@id/profilePictureBackground"
            app:layout_constraintStart_toStartOf="@id/profilePictureBackground"
            app:layout_constraintEnd_toEndOf="@id/profilePictureBackground"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profilePicture"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/pfp_background"
            android:scaleType="centerCrop"
            app:strokeColor="@color/background_beige"
            app:strokeWidth="15dp"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/fullName"
            android:textAlignment="center"
            android:fontFamily="@font/inria_serif_bold"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:text="Name Surname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/profilePicture"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/username"
            android:textAlignment="center"
            android:fontFamily="@font/inria_serif_bold"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:text="username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/fullName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/username">

            <LinearLayout
                android:id="@+id/posts"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="20dp"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:id="@+id/postsCount"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:text="15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/postsText"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:text="posts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>



            </LinearLayout>

            <LinearLayout
                android:id="@+id/followers"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:id="@+id/followersCount"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:text="135"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/followersText"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:text="follows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>



            </LinearLayout>
            <LinearLayout
                android:id="@+id/premium"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:id="@+id/premiumCount"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:text="12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/premiumText"
                    android:textAlignment="center"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:text="premium subscribers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/fullName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>



            </LinearLayout>


        </LinearLayout>


        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabIndicatorHeight="2dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicatorColor="@color/fresh_green"
            app:layout_constraintTop_toBottomOf="@id/info"
            android:layout_marginHorizontal="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/containerInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
