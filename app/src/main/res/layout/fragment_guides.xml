<?xml version="1.0" encoding="utf-8"?>
    <androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_beige"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
    <TextView
        android:id="@+id/certificationsTitle"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:fontFamily="@font/inria_serif_bold"
        android:text="Certifications &amp; Diplomas"
        android:textSize="25dp"
        android:layout_marginVertical="30dp"
        android:layout_marginHorizontal="20dp"
        android:textColor="@color/black"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/certificationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/certificationsTitle"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="0dp"/>

    <TextView
        android:id="@+id/experienceTitle"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/certificationsRecyclerView"
        android:fontFamily="@font/inria_serif_bold"
        android:text="Work Experience"
        android:textSize="25dp"
        android:layout_marginVertical="30dp"
        android:layout_marginHorizontal="20dp"
        android:textColor="@color/black"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/experienceRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/experienceTitle"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="0dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>