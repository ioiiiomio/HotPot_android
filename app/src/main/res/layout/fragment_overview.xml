<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:background="@color/background_beige">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TableLayout
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="16dp"
            android:background="@android:color/transparent">

            <!-- Example Row -->
            <TableRow>
                <TextView
                    android:id="@+id/ageTitle"
                    android:fontFamily="@font/inria_serif_bold"
                    android:text="Age"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/ageBefore"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/ageAfter"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:id="@+id/heightTitle"
                    android:fontFamily="@font/inria_serif_bold"
                    android:text="Height"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/heightBefore"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/heightAfter"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
            </TableRow>
            <TableRow>
                <TextView
                    android:id="@+id/weightTitle"
                    android:fontFamily="@font/inria_serif_bold"
                    android:text="Weight"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/weightBefore"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
                <TextView
                    android:fontFamily="@font/inria_serif_bold"
                    android:id="@+id/weightAfter"
                    android:text="-"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textSize="16sp"
                    android:textColor="#000"/>
            </TableRow>

        </TableLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/myCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statsCard">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="30dp"
            android:gravity="center">
            <TextView
                android:id="@+id/visionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inria_serif_bold"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:text="Vision"
                android:layout_marginVertical="30dp"
                app:layout_constraintHorizontal_bias="0.2"
                app:layout_constraintEnd_toEndOf="@+id/visions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <LinearLayout
                android:id="@+id/visions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/visionTitle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Vision"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Vision"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inria_serif_bold"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:text="Vision"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>