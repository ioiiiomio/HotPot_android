<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/beige_background">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="411dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:src="@drawable/recipe_banner"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/black_gradient_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>



        <LinearLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/banner"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:layout_marginLeft="20dp">
                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/tag1"
                        android:textAlignment="center"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="12sp"
                        android:text="Follow"
                        android:background="@drawable/yellow_rounded_background"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:textStyle="bold"
                        android:layout_marginRight="5dp"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/tag2"
                        android:textAlignment="center"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="12sp"
                        android:text="Follow"
                        android:background="@drawable/light_green_rounded_background"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:textStyle="bold"
                        android:layout_marginRight="5dp"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/tag3"
                        android:textAlignment="center"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="12sp"
                        android:text="Follow"
                        android:background="@drawable/dark_green_rounded_background"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:textStyle="bold"
                        android:layout_marginRight="5dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/articleRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/banner"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="0dp"/>
        <LinearLayout
            android:id="@+id/rating"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/articleRecyclerView"
            android:paddingHorizontal="20dp"
            android:orientation="horizontal"
            android:layout_marginTop="40dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inria_serif_bold"
                android:textSize="16sp"
                android:text="Was this article useful?"
                android:layout_marginTop="5dp"
                android:layout_marginRight="10dp"/>
            <ImageButton
                android:id="@+id/thumbsUpButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_thumbs_up_selector"
                android:layout_marginHorizontal="5dp"/>
            <ImageButton
                android:id="@+id/thumbsDownButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_thumbs_down_selector"
                android:layout_marginHorizontal="5dp"/>

        </LinearLayout>
        <TextView
            android:id="@+id/title"
            android:textAlignment="textStart"
            android:fontFamily="@font/inria_serif_bold"
            android:textColor="@color/black"
            android:textSize="35sp"
            android:text="Stop eating chia pudding"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingLeft="10dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintTop_toBottomOf="@+id/info"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <TextView
                android:id="@+id/description"
                android:textAlignment="textStart"
                android:fontFamily="@font/inria_serif_bold"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_marginHorizontal="15dp"
                android:text="This 10-Ingredient Creamy Vegan Pantry Pasta is made with just a handful of everyday pantry staples and it’ll quickly become part of your regular easy weeknight dinner rotation. It’s creamy, cheesy, and smoky and indulgent yet healthy, and guaranteed to be a crowd pleasing meal."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:layout_marginVertical="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageRecipe"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/header_bg"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImage"
            android:paddingHorizontal="20dp"
            android:layout_marginVertical="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card1"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageRecipe">
            <TextView
                android:id="@+id/ingredients"
                android:textAlignment="textStart"
                android:fontFamily="@font/inria_serif_bold"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_marginHorizontal="15dp"
                android:text="This 10-Ingredient Creamy Vegan Pantry Pasta is made with just a handful of everyday pantry staples and it’ll quickly become part of your regular easy weeknight dinner rotation. It’s creamy, cheesy, and smoky and indulgent yet healthy, and guaranteed to be a crowd pleasing meal."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:layout_marginVertical="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="15dp"
            android:layout_marginHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card2">
            <TextView
                android:id="@+id/instructions"
                android:textAlignment="textStart"
                android:fontFamily="@font/inria_serif_bold"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_marginHorizontal="15dp"
                android:text="This 10-Ingredient Creamy Vegan Pantry Pasta is made with just a handful of everyday pantry staples and it’ll quickly become part of your regular easy weeknight dinner rotation. It’s creamy, cheesy, and smoky and indulgent yet healthy, and guaranteed to be a crowd pleasing meal."
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:paddingLeft="10dp"
                android:layout_marginVertical="20dp"
                app:layout_constraintTop_toBottomOf="@+id/card2"
                app:layout_constraintStart_toStartOf="parent"/>

        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/ratingRecipe"
            android:textAlignment="textStart"
            android:fontFamily="@font/inria_serif_bold"
            android:textColor="@color/black"
            android:layout_marginLeft="20dp"
            android:textSize="25sp"
            android:text="Rating: 5.0"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingLeft="10dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintTop_toBottomOf="@+id/card3"
            app:layout_constraintStart_toStartOf="parent"/>
        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="10dp"
            android:numStars="5"
            android:stepSize="1"
            android:rating="0"
            android:isIndicator="false"
            style="?android:attr/ratingBarStyleSmall"
            app:layout_constraintTop_toBottomOf="@+id/ratingRecipe"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_gravity="start" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/submitRatingButton"
            android:textAlignment="center"
            android:fontFamily="@font/inria_serif_bold"
            android:textSize="20sp"
            android:text="Send"
            android:background="@drawable/light_green_rounded_background"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingHorizontal="20dp"
            android:textStyle="bold"
            android:layout_marginRight="180dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ratingRecipe"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintTop_toBottomOf="@+id/submitRatingButton"
            app:layout_constraintStart_toStartOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>