<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/light_beige"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/profilePicture"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/textContainer"/>
                <LinearLayout
                    android:id="@+id/textContainer"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/profilePicture">
                    <TextView
                        android:layout_marginVertical="10dp"
                        android:id="@+id/dieticianName"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:text="Dr. FullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/occupation"
                        android:layout_marginVertical="3dp"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="12sp"
                        android:text="CLinical Dietician"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/experience"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="11sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:text="Experience: 7+ years"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:id="@+id/about"
                        android:layout_marginVertical="10dp"
                        android:textAlignment="textStart"
                        android:fontFamily="@font/inria_serif_bold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="About: Works with athletes and fitness enthusiasts to optimize performance and recovery."
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>