<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/recipeDetailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Recipe Image -->
        <ImageView
            android:id="@+id/imageViewRecipe"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Recipe Image"
            android:src="@drawable/dummy_recipe" />

        <!-- Recipe Name -->
        <TextView
            android:id="@+id/textViewRecipeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="24sp"
            android:fontFamily="@font/inria_serif_bold"
            android:layout_marginTop="12dp" />

        <!-- Short Description -->
        <TextView
            android:id="@+id/textViewDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A quick description of the recipe."
            android:textSize="16sp"
            android:fontFamily="@font/inria_serif_regular"
            android:layout_marginTop="4dp" />

        <!-- Ingredients Title -->
        <TextView
            android:id="@+id/textViewIngredientsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="20sp"
            android:fontFamily="@font/inria_serif_bold"
            android:layout_marginTop="16dp" />

        <!-- Ingredients List -->
        <TextView
            android:id="@+id/textViewIngredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Ingredient 1\n• Ingredient 2"
            android:textSize="16sp"
            android:fontFamily="@font/inria_serif_regular"
            android:layout_marginTop="4dp" />

        <!-- Instructions Title -->
        <TextView
            android:id="@+id/textViewInstructionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Instructions"
            android:textSize="20sp"
            android:fontFamily="@font/inria_serif_bold"
            android:layout_marginTop="16dp" />

        <!-- Instructions List -->
        <TextView
            android:id="@+id/textViewInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Step one\n2. Step two"
            android:textSize="16sp"
            android:fontFamily="@font/inria_serif_regular"
            android:layout_marginTop="4dp" />

        <!-- Substitutions Title -->
        <TextView
            android:id="@+id/textViewSubstitutionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Substitutions"
            android:textSize="20sp"
            android:fontFamily="@font/inria_serif_bold"
            android:layout_marginTop="16dp" />

        <!-- Substitutions Text -->
        <TextView
            android:id="@+id/textViewSubstitutions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can substitute almond milk with oat milk."
            android:textSize="16sp"
            android:fontFamily="@font/inria_serif_regular"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
